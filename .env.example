# Copy to .env and fill in your keys:  cp .env.example .env
#
# --- Gemini API keys (at least one is required) ---
# Add as many as you have; they are rotated automatically (see README.md).
# Numbering can have gaps; sorting is numeric (KEY_2 before KEY_10).
GEMINI_KEY_1="AIzaSy...your-key-here"
GEMINI_KEY_2="AIzaSy...your-key-here"

# --- Optional tuning ---
# Per-key budget per rolling 60s window (defaults: 3 rpm / 250000 tpm).
# AI_RPM_LIMIT=3
# AI_TPM_LIMIT=250000

# Default single model name (only used as documentation/default; the
# translator actually uses a fallback model chain unless --model is given).
# GEMINI_MODEL=gemini-3-flash-preview

# Override the source DB location (default: translator/data/epitaka.db,
# resolved relative to the translator directory regardless of cwd).
# EPITAKA_DB=/path/to/data/epitaka.db

# Legacy explicit glossary override. Normally NOT needed: the glossary path
# is always derived per language as glossary_<lang>.db next to EPITAKA_DB
# (or via --glossary-db). Only set this if you know why.
# GLOSSARY_DB=/path/to/data/glossary_si.db

# Prompt size budget in estimated tokens (default 200000).
# PROMPT_TOKEN_LIMIT=200000

# Optional: Telegram alert when a run dies with all keys exhausted.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
